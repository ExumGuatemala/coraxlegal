---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url>
        <loc>https://www.coraxlegal.com/</loc>
        <lastmod>2026-10-23</lastmod>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
    </url>
    {%- for integrante in site.equipo %}
    <url>
        <loc>{{ integrante.url | absolute_url }}</loc>
        <lastmod>{{ integrante.actualizado | date: "%Y-%m-%d" }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.8</priority>
    </url>
    {%- endfor %}
    {%- assign servicios = site.servicios | sort: "orden" %}
    {%- for servicio in servicios %}
    <url>
        <loc>{{ servicio.url | absolute_url }}</loc>
        <lastmod>{{ servicio.actualizado | date: "%Y-%m-%d" }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.9</priority>
    </url>
    {%- endfor %}
    <url>
        <loc>https://www.coraxlegal.com/blog/</loc>
        <lastmod>{{ site.posts.first.date | date: "%Y-%m-%d" }}</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.7</priority>
    </url>
    {%- for post in site.posts %}
    <url>
        <loc>{{ post.url | absolute_url }}</loc>
        <lastmod>{{ post.actualizado | default: post.date | date: "%Y-%m-%d" }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
    </url>
    {%- endfor %}
</urlset>
